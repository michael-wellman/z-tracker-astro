---

---

<header>
    <!-- <div class="bar"></div> -->
    <div class="container">
        <div class="leftColumn">
            <span>Z</span> Tracker<br>
            <div class="subtitle">370z Nismo -- Mod Budget Log</div>
        </div>
        <div class="rightColumn">
            <div class="mod-tag">
            <!-- Mod Count needed -->
             14 Mods Logged - 2021-2026
             </div>
        </div>
    </div>
</header>

<style>

    header {
    &::before {
        content:"";
        background: var(--red);
        height: .4rem;
        display: block;
        margin-bottom: .4rem;
    }
    text-transform: uppercase;

    .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;

        .leftColumn {
            font: var(--font-display);
            font-size: clamp(1.9rem, 4vw, 2.6rem);
            letter-spacing: 0.02em;
            text-wrap: balance;
            color: var(--ink);
            
            span {
                color: var(--red)
            }

            .subtitle {
                font: var(--font-body);
                font-size: 0.8rem;
                letter-spacing: 0.14em;
                color: var(--ink-dim);
                margin-top: 4px;
            }
        }
    }

    .bar {
        height: 4px;
        background: var(--red);
    }
    
    .mod-tag {
        font: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
        border: solid 1px var(--ink-faint);
        padding: 5px 10px;
        border-radius: 3px;
        white-space: nowrap;
    }
}


</style>